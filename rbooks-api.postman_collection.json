          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/books/{{book_id}}/sessions/{{session_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "books", "{{book_id}}", "sessions", "{{session_id}}"]
            }
          }
        }
      ]
    },
